# Copy to .env and adjust. Used by docker-compose.yml.

# --- Demo mode ---
# true : every start wipes the data and loads demo accounts/people; ./stop.sh also deletes the volumes;
#        OTP codes are shown on screen (no inbox needed) and demo logins are shown on the login pages
# false: starts empty (departments only); ./stop.sh keeps the data
DEMO=false
DEMO_PASSWORD=demo12345

# --- Web ---
APP_PORT=8080
APP_TIMEZONE=Asia/Kolkata

# --- First admin (optional; created on start when no admin exists) ---
# Leave empty to create the first admin through the sign-up page instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Database ---
DB_NAME=student_management
DB_USER=student
DB_PASSWORD=student

# --- Email (OTP, welcome and password-change mails) ---
# Default: the bundled Mailpit catcher, readable at http://localhost:8025
MAILPIT_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
# tls | ssl | none
SMTP_SECURE=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@student.local
MAIL_FROM_NAME=Student Management

# Example for Gmail (use an App Password, never the account password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# MAIL_FROM=you@gmail.com
